#! /usr/bin/env ruby

=begin

  aromancer

  entry point for aromancer.

  by i2097i

=end

require :aromancer.to_s

puts ARGV
font = TTY::Font.new(:standard)
title = font.write("aromancer", letter_spacing: 1)
print TTY::Box.frame(
  *(title.split("\n") +
  ["dood", "wut"]),
  width: TTY::Screen.width,
  height: TTY::Screen.height,
  align: :center,
  title: {top_left: Aromancer.to_s, bottom_right: Aromancer::VERSION}
)

Aromancer::Prompt.say("$ >[Aromancer]> : ")
