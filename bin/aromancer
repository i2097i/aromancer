#! /usr/bin/env ruby

=begin

  aromancer

  entry point for aromancer.

  by i2097i

=end

require :aromancer.to_s

begin
  Aromancer::Prompt.say(I18n.t("shared.welcome", version: Aromancer::VERSION))
  if Aromancer::Storage.get_player
    Aromancer::Routes.main_menu
  else
    Aromancer::Routes.authentication
  end
rescue Interrupt => e
  exit
end

